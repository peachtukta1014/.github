#!/bin/sh
# reflex/check - is this address still valid? ok | MOVED | BROKEN
# Found 6 live broken doc ids on 2026-11-21 that no other checker caught.
# Usage: check [id ...]   (no args = every registered id)
set -e
W=/var/minis/shared/tools/bin/ws_exec.py
R=/srv/repos/hq/vm-hq-core
$W --command "cd $R && python3 - '$*' <<'PY'
import json,os,subprocess,sys
want=sys.argv[1].split() if len(sys.argv)>1 else []
d=json.load(open('registry/docids.json',encoding='utf-8')); ids=d.get('ids',{})
idn=want or sorted(ids)
bad=0
for i in idn:
    p=subprocess.run(['bin/doc.py','path',i],capture_output=True,text=True).stdout.strip()
    if not p or not os.path.isfile(p): print(f'{i:24} BROKEN  (no such file)'); bad+=1; continue
    sz=os.path.getsize(p); head=open(p,encoding='utf-8',errors='replace').read(600)
    if sz<900 and 'MOVED' in head.upper(): print(f'{i:24} MOVED   {p}  ({sz}B stub)'); bad+=1
    else: print(f'{i:24} ok      {p}')
print('---'); print(f'bad={bad} / total={len(idn)}')
sys.exit(1 if bad else 0)
PY"
